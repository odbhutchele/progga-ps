generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String @id
  username String @unique
  password String
}

model Student {
  id               String          @id
  studentId        Int             @unique
  password         String
  name             String
  surname          String
  phone            String?
  address          String
  img              String?
  bloodType        String
  sex              UserSex
  createdAt        DateTime        @default(now())
  sectionId        Int?
  sectionRelation  Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  section          String?
  fatherName       String?
  motherName       String?
  rollNo           Int?
  group            String?
  shift            String?
  guardianName     String?
  guardianPhone    String?

  // Admission form fields
  admissionYear     Int?
  nameBn            String?   // শিক্ষার্থীর নাম (বাংলায়)
  birthRegNo        String?   // জন্মনিবন্ধন নং
  prevSchoolName    String?   // পূর্ববর্তী শিক্ষা প্রতিষ্ঠান
  prevSchoolClass   String?
  prevSchoolSection String?
  prevSchoolRoll    String?
  prevTutors        String?   // গত দুই বছরে যাদের কাছে পড়েছো
  fatherNameEn      String?   // পিতার নাম (English)
  fatherPhone       String?   // পিতার মোবাইল
  fatherNid         String?   // পিতার জাতীয় পরিচয়পত্র নং
  fatherAddress     String?   // পিতার বর্তমান ঠিকানা
  fatherUpazila     String?   // পিতার উপজেলা/থানা
  fatherWorkAddress String?   // পিতার কর্মস্থলের ঠিকানা
  motherNameEn      String?   // মাতার নাম (English)
  motherNid         String?   // মায়ের জাতীয় পরিচয়পত্র নং
  religion          String?
  birthVillage      String?   // জন্মস্থান - গ্রাম/শহর
  birthDistrict     String?   // জন্মস্থান - জেলা ও পোস্ট
  birthUpazila      String?   // জন্মস্থান - উপজেলা
  birthThana        String?   // জন্মস্থান - থানা
  permVillage       String?   // স্থায়ী ঠিকানা - গ্রাম/শহর
  permDistrict      String?   // স্থায়ী ঠিকানা - জেলা ও পোস্ট
  permUpazila       String?   // স্থায়ী ঠিকানা - উপজেলা
  permThana         String?   // স্থায়ী ঠিকানা - থানা
  prevPassMarks     Int?
  prevSubjectCount  Int?
  prevSession       String?

  classId          Int
  class            Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances      Attendance[]
  results          Result[]
  customTuitionFee Float?
  feeCollections   FeeCollection[]
  reportCards      ReportCard[]
  birthday         DateTime
}

model Teacher {
  id                String              @id
  teacherId         Int                 @unique @default(autoincrement())
  password          String
  name              String
  surname           String
  email             String?             @unique
  phone             String?
  address           String
  img               String?
  bloodType         String
  sex               UserSex
  createdAt         DateTime            @default(now())
  subjects          Subject[]
  lessons           Lesson[]
  classes           Class[]
  birthday          DateTime
  monthlySalary     Float?
  salaryCollections SalaryCollection[]
  sections          Section[]
}


model Class {
  id       Int    @id @default(autoincrement())
  name     String @unique  // numeric string: "1", "2", ... "6"
  capacity Int

  supervisorId  String?
  supervisor    Teacher?       @relation(fields: [supervisorId], references: [id])
  lessons       Lesson[]
  students      Student[]
  events        Event[]
  announcements Announcement[]
  feePackages   FeePackage[]
  notices       Notice[]
  subjects      Subject[]
  examSchedules ExamSchedule[]
  attendances   Attendance[]
  sections      Section[]
}

model Section {
  id           Int       @id @default(autoincrement())
  name         String
  capacity     Int?
  classId      Int
  class        Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  supervisorId String?
  supervisor   Teacher?  @relation(fields: [supervisorId], references: [id])
  students     Student[]
  createdAt    DateTime  @default(now())

  @@unique([name, classId])
}

model Subject {
  id            Int            @id @default(autoincrement())
  name          String
  classId       Int
  class         Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  teachers      Teacher[]
  lessons       Lesson[]
  examSchedules ExamSchedule[]
  results       Result[]

  @@unique([name, classId])
}

model Lesson {
  id        Int      @id @default(autoincrement())
  name      String
  day       Day
  startTime DateTime
  endTime   DateTime

  subjectId   Int
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId     Int
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model Exam {
  id             Int            @id @default(autoincrement())
  title          String
  semesterNumber Int?
  year           Int?
  semStartDate   DateTime?
  semEndDate     DateTime?
  results        Result[]
  examSchedules  ExamSchedule[]
}

model Result {
  id         Int    @id @default(autoincrement())
  score      Int
  oralScore  Int    @default(0)
  gpa        Float? @default(0.0)
  grade      String? @default("F")

  examId    Int?
  exam      Exam?    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId Int?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, examId, subjectId])
}

model Attendance {
  id      Int      @id @default(autoincrement())
  date    DateTime
  present Boolean

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   Int
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id], onDelete: Cascade)
}

model FeePackage {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  amount      Float
  type        FeePackageType  @default(OTHER_FEE)
  classId     Int?
  class       Class?          @relation(fields: [classId], references: [id], onDelete: Cascade)
  collections FeeCollection[]
}

model FeeCollection {
  id           Int         @id @default(autoincrement())
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feePackageId Int?
  feePackage   FeePackage? @relation(fields: [feePackageId], references: [id], onDelete: Cascade)
  name         String
  amount       Float
  month        String?     // e.g. "2026-01"
  status       FeeStatus   @default(UNPAID)
  paidAmount   Float       @default(0)
  paidAt       DateTime?
  receiptNo    String?
  receivedById String?
}

model Expense {
  id       Int      @id @default(autoincrement())
  title    String
  amount   Float
  date     DateTime @default(now())
  category String
}

model InventoryItem {
  id              Int                 @id @default(autoincrement())
  name            String
  category        String?
  description     String?
  buyingPrice     Float
  sellingPrice    Float
  quantityInStock Int                 @default(0)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  movements       InventoryMovement[]

  @@index([name])
  @@index([category])
  @@index([isActive])
}

model InventoryMovement {
  id               Int                   @id @default(autoincrement())
  itemId           Int
  item             InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type             InventoryMovementType
  quantity         Int
  unitBuyingPrice  Float?
  unitSellingPrice Float?
  totalAmount      Float
  note             String?
  createdAt        DateTime              @default(now())

  @@index([itemId])
  @@index([type])
  @@index([createdAt])
}

model BonusPackage {
  id          Int                @id @default(autoincrement())
  name        String
  amount      Float
  description String?
  createdAt   DateTime           @default(now())
  collections SalaryCollection[]
}

model SalaryCollection {
  id             Int           @id @default(autoincrement())
  teacherId      String
  teacher        Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name           String
  amount         Float
  bonus          Float         @default(0)
  deduction      Float         @default(0)
  note           String?
  month          String        // e.g. "2026-06"
  type           SalaryType    @default(SALARY)
  bonusPackageId Int?
  bonusPackage   BonusPackage? @relation(fields: [bonusPackageId], references: [id], onDelete: SetNull)
  status         SalaryStatus  @default(UNPAID)
  paidAmount     Float         @default(0)
  paidAt         DateTime?
  receiptNo      String?       @unique
  receivedById   String?
}

model Notice {
  id             Int        @id @default(autoincrement())
  title          String
  content        String
  date           DateTime   @default(now())
  type           NoticeType @default(SMS)
  recipientId    String?
  classId        Int?
  class          Class?     @relation(fields: [classId], references: [id], onDelete: Cascade)
  recipientCount Int        @default(0)
  sentCount      Int        @default(0)
  status         String     @default("PENDING")
}

model ExamSchedule {
  id          Int      @id @default(autoincrement())
  examId      Int
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId   Int
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId     Int
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  date        DateTime
  startTime   DateTime?
  endTime     DateTime?
  room        String?
  totalMarks  Int      @default(100)
}

model ReportCard {
  id               Int      @id @default(autoincrement())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term             String   @default("")
  gpa              Float    @default(0)
  grade            String   @default("F")
  year             Int      @default(0)
  academicYear     String?
  comments         String?
  moralBehavior    String?
  sports           Boolean  @default(false)
  culturalFunction Boolean  @default(false)
  scoutBnc         Boolean  @default(false)
  mathOlympiad     Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@unique([studentId, academicYear])
}

model SmsConfig {
  id       Int    @id @default(autoincrement())
  apiUrl   String
  apiKey   String
  senderId String
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  SAT
  SUNDAY
}

enum FeePackageType {
  TUITION
  OTHER_FEE
}

enum FeeStatus {
  PAID
  UNPAID
  PENDING
}

enum SalaryStatus {
  PAID
  UNPAID
}

enum SalaryType {
  SALARY
  BONUS
}

enum InventoryMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
}

enum NoticeType {
  SMS
  EMAIL
  SYSTEM
}
